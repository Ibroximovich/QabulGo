APP_ENV=development
PORT=8080

# PostgreSQL Connection
DATABASE_URL=postgres://qabulgo:qabulgo_secret_2026@localhost:5433/qabulgo?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# JWT Configuration
JWT_SECRET=super_secret_jwt_signing_key_qabulgo_2026_minimum_32_chars!
JWT_ISSUER=qabulgo-api
JWT_AUDIENCE=qabulgo-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Cookie Security (development rejimida false, HTTPS da true bo'lishi kerak)
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Frontend URL (CORS uchun)
FRONTEND_URL=http://localhost:5173

# Terms of Service Version
TERMS_VERSION=v1.0

# SMTP / Email Configuration
# Agar SMTP sozlanmagan bo'lsa yoki EMAIL_MOCK=true bo'lsa, kodlar server logida ko'rinadi
EMAIL_MOCK=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@qabulgo.uz
SMTP_PASSWORD=secret_smtp_password
SMTP_FROM=QabulGo <no-reply@qabulgo.uz>

# Rate Limit Configuration (so'rovlar soni / soniya)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
